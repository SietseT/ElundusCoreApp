{
  "productName": "Elundus Core",
  "identifier": "sito.elunduscore",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../public/icon.icns", "../public/icon.ico", "../public/icon.png"]
  },
  "app": {
    "windows": [
      {
        "title": "Elundus Core",
        "width": 1024,
        "height": 750,
        "minWidth": 330,
        "minHeight": 190
      }
    ],
    "security": {
      "csp": null
    }
  }
}
