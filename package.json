{
  "name": "elundus-core",
  "type": "module",
  "description": "Use this simple desktop application to simulate StreamElements text-to-speech (TTS) voice messages for Twitch. Hear how a donation for your favorite streamer sounds like!",
  "author": {
    "name": "Sietse Trommelen"
  },
  "repository": "https://github.com/SietseTrommelen/ElundusCoreApp",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "audit:fix": "npx yarn-audit-fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,html,json}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "pinia": "^4",
    "vue": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6",
    "@vueuse/core": "^14",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.6",
    "radix-vue": "^1",
    "tailwind-merge": "^3",
    "tailwindcss": "^4",
    "vite": "^8.2.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
